{
  "name": "jevremote",
  "version": "0.1.0",
  "description": "Text-first browser decisions with TypeSafe Jev and Playwright.",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node --env-file=.env dist/src/cli.js",
    "dev": "npm run start",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
